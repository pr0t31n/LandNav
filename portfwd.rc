# LandNav port forwards — run after session opens
# Usage: resource /opt/pr0t31n/LandNav/portfwd.rc
#
# Forwards beretta services to c2-server high ports (c2-server already
# hosts Vantage/Crucible/Nessus locally on the standard ports).

sessions -c "portfwd add -l 25100 -p 5100 -r 127.0.0.1"
sessions -c "portfwd add -l 25500 -p 5500 -r 127.0.0.1"
sessions -c "portfwd add -l 28834 -p 8834 -r 127.0.0.1"

echo ""
echo "Port forwards active:"
echo "  c2-server:25100 → beretta:5100 (Vantage)"
echo "  c2-server:25500 → beretta:5500 (Crucible)"
echo "  c2-server:28834 → beretta:8834 (Nessus)"
echo ""
