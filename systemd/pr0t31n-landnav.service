[Unit]
Description=pr0t31n LandNav Network Bootstrapper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/pr0t31n/LandNav/landnav.py
WorkingDirectory=/opt/pr0t31n/LandNav
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
