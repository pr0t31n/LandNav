[Unit]
Description=LandNav — Rogue device network bootstrapper
Documentation=https://github.com/pr0t31n/LandNav
After=network-pre.target systemd-networkd-wait-online.service
Before=network.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/pr0t31n/landnav/landnav.py --config /opt/pr0t31n/landnav/config.yaml
WorkingDirectory=/opt/pr0t31n/landnav
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=landnav

# Run before NetworkManager so LandNav controls the interfaces
# rather than NM fighting over them
ExecStartPre=/bin/sleep 5

# Security — still need root for raw sockets, bridge, ebtables
User=root
Group=root

# Prevent NM from managing our interfaces while LandNav runs
Environment=NM_MANAGED=0

[Install]
WantedBy=multi-user.target
